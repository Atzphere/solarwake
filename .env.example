# IMPORTANT: set this to the Home Assistant base URL accessible FROM brandywine.
# Use whatever URL you normally use to open HA, without /config or /api.
HA_URL=http://192.168.1.80
# Home Assistant user profile > Security > Long-Lived Access Tokens
HA_TOKEN=REPLACE_WITH_YOUR_LONG_LIVED_ACCESS_TOKEN
# Docker VM LAN address (the example is your brandywine address).
# Bind only on a trusted LAN/Tailscale, never publicly port-forward.
BIND_IP=192.168.1.71
